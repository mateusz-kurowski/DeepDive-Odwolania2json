OPENAI_API_KEY=
OPENAI_BASE_URL=https://ollama.mydomain.com
LLM_MODEL=extractor

# OCR skanów: model z wizją (vlm, domyślnie) albo opcjonalny Tesseract (tesseract)
OCR_BACKEND=vlm
VLM_MODEL=
# VLM_BASE_URL= i VLM_API_KEY= tylko gdy inny endpoint niż OPENAI_*

LANGFUSE_SECRET_KEY="sk-***"
LANGFUSE_PUBLIC_KEY="pk-lf-***"
LANGFUSE_BASE_URL="https://langfuse.mydomain.com"

EXTRACTION_MODE=hybrid
CLASSES_DIR=classes
CITATION_THRESHOLD=85
# Parametry wywołań LLM (max_tokens, temperature, extra_body); domyślnie config/llm.json
LLM_CONFIG=config/llm.json

# --- API i UI (docker compose up) ---
# Object storage na pliki użytkowników i wyniki ewaluacji z UI. Bez S3_BUCKET: katalog ./storage.
# S3_BUCKET=odwolania2json
# S3_ENDPOINT_URL=http://minio:9000   # tylko MinIO / S3-compatible
# S3_REGION=eu-central-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_CREATE_BUCKET=true               # utwórz bucket, jeśli nie istnieje
MAX_UPLOAD_MB=25
# EVAL_DATASETS=config/eval-datasets.yaml   # zbiory do ewaluacji (lokalne)
# RESULTS_DIR=results                       # domyślne wyniki ewaluacji (lokalne, odczyt)
# SAMPLES_DIR=data/szablon-aplikacja/input  # przycisk „Użyj przykładowych”
